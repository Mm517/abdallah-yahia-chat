PORT=3000

# Supabase project (Project Settings → API)
SUPABASE_URL=https://tnlmqkwmhrnhgxxhwfpy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string (Project Settings → Database).
# SUPABASE_DB_URL is used so it does not conflict with Replit's managed DATABASE_URL.
# Use the pooled "Transaction" mode URL if deploying serverless.
SUPABASE_DB_URL=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
